#!/usr/bin/env bash
# Quiet Playwright Haskell tests.
#
# Extra args go to Tasty:
#   playwright-test -p /page-goto/
#   playwright-test -p '/page-goto/&&/should work/'
#   playwright-test --list-tests
# TASTY_PATTERN is also honored (Tasty reads it itself).
#
# Tests run in parallel: Tasty's default --num-threads is the number of
# RTS capabilities, and the test binary is linked with -N (CPU threads).
# Override with --num-threads / -j or TASTY_NUM_THREADS.
set -eu

hpack --force

cabal build playwright-test
bin="$(cabal list-bin playwright:test:playwright-test)"

filter_noise() {
  grep -v 'Skipping host requirements validation' | grep -vE '^All [0-9]+ tests passed' || true
}

ensure_matches() {
  listed="$("$bin" --list-tests "$@" 2>/dev/null || true)"
  if [ -z "$listed" ]; then
    echo "playwright-test: pattern matched no tests: $*" >&2
    exit 1
  fi
}

pass_through=0
for arg in "$@"; do
  case "$arg" in
    --help|-h|--list-tests)
      pass_through=1
      ;;
  esac
done

if [ "$pass_through" -eq 1 ]; then
  "$bin" --hide-successes --hide-progress --color=never "$@"
  exit $?
fi

if [ "$#" -gt 0 ] || [ -n "${TASTY_PATTERN:-}" ]; then
  ensure_matches "$@"
fi

set +e
output="$("$bin" --hide-successes --hide-progress --color=never "$@" 2>&1)"
status=$?
set -e
printf '%s\n' "$output" | filter_noise
exit "$status"
